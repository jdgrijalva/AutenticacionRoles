@model IEnumerable<AutenticacionRoles.Models.Pelicula>

@{
    ViewData["Title"] = "Películas";
}

<h1>Listado de películas</h1>

@if (User.IsInRole("Curador"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Crear nueva pelicula</a>
    </p>
}


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Director)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DuracionMinutos)
            </th>
            <th>
                Género
            </th>
            <th>
                Acciones
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Titulo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Director)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DuracionMinutos)
                </td>
                <td>
                    @item.Genero?.Nombre
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                    @if (User.IsInRole("Curador"))
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>
