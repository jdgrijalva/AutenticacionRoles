@model AutenticacionRoles.Models.Pelicula

@{
    ViewData["Title"] = "Detalles de la película";
}

<h1>Detalles de la película</h1>

<div>
    <h4>Información de la película</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Titulo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Titulo)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Director)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Director)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DuracionMinutos)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DuracionMinutos)
        </dd>

        <!-- Nombre del género relacionado -->
        <dt class="col-sm-2">
            Género
        </dt>
        <dd class="col-sm-10">
            @Model.Genero?.Nombre
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-primary">Editar</a>

    <a asp-action="Index" class="btn btn-secondary">
        Volver a la lista
    </a>
</div>
