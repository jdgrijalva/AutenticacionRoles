@model IEnumerable<AutenticacionRoles.Models.Genero>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole("Curador"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Insertar nuevo género</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Peliculas)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(model => item.Peliculas)
            </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                    @if (User.IsInRole("Curador"))
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    }
                </td>

        </tr>
}
    </tbody>
</table>
